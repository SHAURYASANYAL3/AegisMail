# AegisMail Environment Configuration
AEGIS_ENV=development
AEGIS_PORT=8000
AEGIS_HOST=0.0.0.0
DEMO_MODE=true
DATABASE_URL=sqlite:///./aegismail.db

# Security
SECRET_KEY=dev_insecure_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Optional External Threat Intel APIs (Zero required for core/offline operation)
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
